# SHORTLIST Pro — Production Environment Variables Template

# 1. Supabase Backend Authentication (Email/Password, Google OAuth, GitHub OAuth)
# Get keys from your Supabase Project Settings -> API: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Canonical Site URL for SEO, Sitemap & OAuth Redirects
NEXT_PUBLIC_SITE_URL="https://craftats-ai.vercel.app"

# 3. Google Search Console Verification (Optional: paste your HTML tag token)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# 4. Razorpay Payment Gateway (Instant UPI, GPay, PhonePe, Paytm, QR, Cards, Netbanking)
# Get keys from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET=""

# 5. Primary Receiving UPI ID (Funds deposited directly with 0% gateway commission)
NEXT_PUBLIC_MERCHANT_UPI_ID="darsheel.sirola@fam"

# 6. Optional Gemini AI API Key (for LLM-powered deep resume enhancement fallback)
GEMINI_API_KEY=""

# 7. Optional Stripe Configuration (for international cards)
STRIPE_SECRET_KEY=""
